model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 'Sheets on the google sheet'

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Layer 1'

	annotation PBI_QueryGroupOrder = 2

queryGroup 'Final layer'

	annotation PBI_QueryGroupOrder = 3

annotation PBI_QueryOrder = ["_Measures","Last refresh","Clubs","Division","Events","Match_day","Match_events","Matches","Player","Boat_brands","Boats","People","Player_registration","Referee","Staff_registration","Team_registration","Teams","Tournament","Tournament_ranking","Tournaments_info","DIM_Referee","DIM division","DIM country","DIM tournament","DIM teams","DIM first referee","DIM second referee","DIM club","FACT ranking","DIM player","Country"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBIDesktopVersion = 2.143.1378.0 (25.05)+4e1de9c957866bc5336e0d250838314aa54ff3a8

annotation PBI_ProTooling = ["DaxQueryView_Desktop","DevMode"]

annotation __TEdtr = 1

annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["OBJECTS_WITH_NO_DESCRIPTION","ENSURE_TABLES_HAVE_RELATIONSHIPS","MODEL_SHOULD_HAVE_A_DATE_TABLE","MINIMIZE_POWER_QUERY_TRANSFORMATIONS","RELATIONSHIP_COLUMNS_SHOULD_BE_OF_INTEGER_DATA_TYPE","ADD_DATA_CATEGORY_FOR_COLUMNS","DATECOLUMN_FORMATSTRING"]}

ref table _Measures
ref table 'Last refresh'
ref table 'DIM first referee'
ref table 'DIM second referee'
ref table 'DIM teams'
ref table 'FACT ranking'
ref table 'DIM division'
ref table 'DIM country'
ref table 'DIM club'
ref table 'DIM player'
ref table 'DIM tournament'

ref cultureInfo en-US

